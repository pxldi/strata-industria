{
  "multipart": [
    {
      "apply": {
        "model": "strataindustria:block/valve_open"
      },
      "when": {
        "open": "true",
        "powered": "false"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/valve_shut"
      },
      "when": {
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/valve_shut"
      },
      "when": {
        "open": "true",
        "powered": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm",
        "x": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "strataindustria:block/bronze_fluid_pipe_arm",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    }
  ]
}